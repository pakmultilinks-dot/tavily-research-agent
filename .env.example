# Copy this file to .env for local use only. NEVER commit a real key.
# Get a key at https://app.tavily.com/home
# Hackathon participants were given coupon code GEEKROOM2 for 8000 Tavily credits,
# redeemable before November 28, 2026 (per the resources list supplied by the user).
# Claiming credits and signing in are NOT done by this repo; do that in your own browser.
TAVILY_API_KEY=

# Optional, only if you want an LLM-written summary instead of the extractive fallback.
# If LLM_API_KEY is empty, the app uses the extractive fallback and labels it as such.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
